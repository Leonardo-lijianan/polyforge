{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-engine.local/contract.schema.json",
  "title": "We-Engine Contract DSL",
  "description": "契约文件校验规则。YAML 文件解析后按此校验。",
  "type": "object",
  "required": ["kind"],
  "additionalProperties": false,
  "if": { "properties": { "kind": { "const": "domain" } } },
  "then": { "required": ["domain"] },
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["domain", "global"],
      "description": "文件种类：domain=业务域，global=全局共享"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "域名（kind=domain 时必填）"
    },
    "description": { "type": "string" },
    "enums": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/EnumDef" }
    },
    "entities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/EntityDef" }
    },
    "views": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/ViewDef" }
    },
    "rules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/RuleDef" }
    },
    "api": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/ApiDef" }
    }
  },

  "$defs": {
    "EnumDef": {
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "state": { "$ref": "#/$defs/StateDef" }
      }
    },

    "StateDef": {
      "type": "object",
      "required": ["initial", "transitions"],
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "string" },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TransitionDef" }
        }
      }
    },

    "TransitionDef": {
      "type": "object",
      "required": ["from", "to", "action"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "to": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "action": { "type": "string" },
        "by": {
          "type": "array",
          "items": { "type": "string" }
        },
        "guard": { "type": "string" }
      }
    },

    "EntityDef": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/FieldDef" }
        },
        "indexes": {
          "type": "array",
          "description": "表级索引（复合索引；单列可用字段级 index/unique）",
          "items": {
            "type": "object",
            "required": ["fields"],
            "additionalProperties": false,
            "properties": {
              "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "unique": { "type": "boolean" },
              "name": { "type": "string" }
            }
          }
        }
      }
    },

    "FieldDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "ref": { "type": "string" },
        "idType": { "type": "string", "enum": ["long", "string", "uuid"] },
        "from": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$" },
        "length": { "type": "integer", "minimum": 1 },
        "precision": { "type": "integer", "minimum": 0 },
        "scale": { "type": "integer", "minimum": 0 },
        "unique": { "type": "boolean" },
        "index": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "default": {},
        "auto": { "type": "string", "enum": ["create", "update"] },
        "sensitive": { "type": "string", "enum": ["mask", "hide"] },
        "writeOnly": { "type": "boolean" },
        "note": { "type": "string" },
        "enum": { "type": "array", "items": { "type": "string" } },
        "of": { "type": "string" },
        "derived": { "type": "string", "enum": ["text", "join", "relation", "permission", "compute"] },
        "via": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "fillFrom": { "type": "string" },
        "validate": { "$ref": "#/$defs/ValidateDef" },
        "validateRef": { "type": "string" }
      }
    },

    "ValidateDef": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/ValidateObject" }
      ]
    },

    "ValidateObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "message": { "type": "string" }
      }
    },

    "ViewDef": {
      "type": "object",
      "required": ["kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "kind": { "type": "string", "enum": ["form", "query", "brief", "detail"] },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/FieldDef" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "RuleDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "pattern": { "type": "string" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "message": { "type": "string" }
      }
    },

    "ApiDef": {
      "type": "object",
      "required": ["method", "path"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "auth": { "$ref": "#/$defs/AuthDef" },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "query": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/FieldDef" }
        },
        "pathParams": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/FieldDef" }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_]+$" }
        },
        "transaction": { "type": "boolean" },
        "deprecated": { "type": "boolean" }
      }
    },

    "AuthDef": {
      "oneOf": [
        { "type": "string", "enum": ["public", "authenticated"] },
        { "$ref": "#/$defs/AuthObject" }
      ]
    },

    "AuthObject": {
      "type": "object",
      "required": ["roles"],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "scope": { "type": "string", "enum": ["self", "rela", "all"] }
      }
    }
  }
}
