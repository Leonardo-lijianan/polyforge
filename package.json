{
  "name": "@leonardo-lijianan/polyforge",
  "version": "1.0.1",
  "description": "一份模型定义，生成数据库 / 后端 / 前端代码",
  "type": "module",
  "license": "MIT",
  "author": "Leonardo <3572113478@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonardo-lijianan/polyforge.git"
  },
  "homepage": "https://github.com/Leonardo-lijianan/polyforge#readme",
  "bugs": {
    "url": "https://github.com/Leonardo-lijianan/polyforge/issues"
  },
  "keywords": [
    "code-generator",
    "schema",
    "yaml",
    "model-driven",
    "contract-first",
    "polyforge"
  ],
  "bin": {
    "polyforge": "index.mjs"
  },
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "config.mjs",
    "source.mjs",
    "snapshot.mjs",
    "cli",
    "parser",
    "validate",
    "generators",
    "schemas",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^5.4.3",
    "ajv": "^8.20.0"
  },
  "scripts": {
    "check": "node index.mjs check",
    "gen": "node index.mjs gen",
    "gen:check": "node index.mjs gen && git diff --exit-code",
    "test": "node tests/run.mjs && node tests/alter-diff.mjs && node tests/gen-smoke.mjs && node tests/docs-sync.mjs"
  }
}
