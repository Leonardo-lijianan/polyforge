# 依赖
node_modules/

# 测试临时目录（tests/run.mjs 每个 case 创建后删除，异常中断时可能残留）
tests/.tmp/

# 运行时工作目录（clone 的契约缓存 + manifest）
.polyforge/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# 构建产物（如果有）
dist/
coverage/

# 本地环境变量
.env
.env.local
.env.*.local
